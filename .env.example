# GroovGro environment variables
# Copy names into Cursor Cloud Agent secrets and Vercel project environment settings.
# Never put real values in this file or anywhere else in git.

# --- App ---
# After groovgro.com is attached in Vercel, set this to https://groovgro.com
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# --- Database (Neon Postgres via Vercel Marketplace) ---
DATABASE_URL=
# Neon also commonly injects:
# POSTGRES_URL=
# DATABASE_URL_UNPOOLED=

# --- Auth (Clerk, recommended on Vercel Marketplace) ---
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Payments (Stripe) ---
# Keep STRIPE_SECRET_KEY as sk_test_. Do not replace with a live secret.
# Do not delete the Ocean Sailing Adventures live webhook (stripe-osa endpoint).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Optional: AI Gateway (plain-language rewrite of intelligence only) ---
# On Vercel, OIDC can authenticate the gateway without this key.
# AI_GATEWAY_API_KEY=
